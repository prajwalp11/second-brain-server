@startuml SecondBrainLLD_v2
title Second Brain — Low Level Design v2
skinparam linetype ortho
skinparam rankdir TB
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #E6F1FB
skinparam classBorderColor #185FA5
skinparam arrowColor #185FA5
skinparam noteBackgroundColor #FAEEDA
skinparam noteBorderColor #BA7517
skinparam packageBackgroundColor #F1EFE8
skinparam packageBorderColor #888780
skinparam defaultFontName Helvetica

' ============================================================
' ENTITIES
' ============================================================
package "entities" {

  class User {
    - id : UUID <<PK>>
    - name : String
    - email : String <<unique among active users — partial index WHERE is_deleted=false>>
    - passwordHash : String <<nullable for SSO users>>
    - authProvider : String <<EMAIL|GOOGLE|APPLE>>
    - emailVerified : Boolean
    - isDeleted : Boolean <<soft-delete: data wiped, login blocked, row+email kept>>
    
    - profilePictureUrl : String
    - timezone : String
    - aiDailyLimit : Integer
    - aiUsedToday : Integer
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    --
    + toDto() : UserDto
  }

  class OtpToken {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - purpose : OtpPurpose <<enum>>
    - tokenHash : String
    - expiresAt : LocalDateTime
    - used : boolean
    - attempts : int
    - createdAt : LocalDateTime
  }
  note right of OtpToken
    Single shared OTP table (otp_tokens) for ALL auth
    flows — purpose = EMAIL_VERIFICATION | PASSWORD_RESET
    | ACCOUNT_DELETION. Stores a HASH of a 6-digit code
    (never the raw code). Single-use, configurable expiry
    (auth.otp.expiry-ms). Emailed via Resend. Send-rate
    limited (auth.otp.max-requests per request-window-hours,
    default 5/12h) and brute-force limited (attempts >=
    auth.otp.max-attempts, default 10). Old codes of the same
    purpose invalidated when a new one is issued. Hourly
    cleanup via OtpTokenCleanupScheduler. Issued/verified
    through AuthService.issueOtp()/consumeOtp() helpers —
    no per-purpose duplication.
  end note

  class JobExecutionLog {
    - id : UUID <<PK>>
    - jobName : String
    - status : String
    - startedAt : LocalDateTime
    - finishedAt : LocalDateTime
    - errorMessage : String
    - details : String
    - createdAt : LocalDateTime
  }
  note right of JobExecutionLog
    Audit trail — one row per scheduled
    job run (SUCCESS/FAILED + exception).
    Written by JobLogService wrapper.
  end note

  class Domain {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - domainType : DomainType <<enum>>
    - customName : String
    - skillLevel : SkillLevel <<enum>>
    - status : DomainStatus <<enum>>
    - planDescription : String
    - context : String
    - weeklySchedule : String
    - linkedResourceUrl : String
    - linkedResourceTitle : String
    - currentStreak : Integer
    - longestStreak : Integer
    - lastLogDate : LocalDate
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    --
    + toDto() : DomainDto
    + isStreakBroken() : boolean
  }

  class DomainMetricDefinition {
    - id : UUID <<PK>>
    - domainId : UUID <<FK>>
    - metricKey : String
    - label : String
    - unit : String
    - isTrackedPerSession : boolean
    - isPR : boolean
    - isHigherBetter : boolean
    - minValue : Double
    - maxValue : Double
    - displayOrder : Integer
    --
    + toDto() : MetricDefinitionDto
  }

  note right of DomainMetricDefinition
    All domains use this same table.
    GYM rows example:
      bench_press_kg / kg / isPR=true / higherBetter=true
      squat_kg       / kg / isPR=true / higherBetter=true
      deadlift_kg    / kg / isPR=true / higherBetter=true
      total_volume_kg/ kg / isPR=false
    RUNNING rows example:
      distance_km    / km  / isPR=true / higherBetter=true
      pace_per_km    / min / isPR=true / higherBetter=false
      elevation_m    / m   / isPR=false
    GUITAR rows example:
      practice_min   / min / isPR=false
      songs_completed/ num / isPR=false
    Zero domain-specific tables.
  end note

  class SessionLog {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - domainId : UUID <<FK>>
    - sessionType : String
    - logDate : LocalDate
    - durationMinutes : Integer
    - feelScore : Integer
    - feelLabel : FeelLabel <<enum>>
    - notes : String
    - linkedReferenceUrl : String
    - createdAt : LocalDateTime
    --
    + toDto() : SessionLogDto
  }

  note right of SessionLog
    notes = free text for any detail
    user wants — e.g. "4 sets bench:
    60/65/67.5/70kg". Not queried.
    No exerciseData column.
    No JSONB. No special gym handling.
  end note

  class DomainInsight {
    - domainId : UUID <<PK/FK>>
    - highlights : String <<JSON>>
    - patterns : String <<JSON>>
    - suggestions : String <<JSON>>
    - generatedAt : LocalDateTime
  }
  note right of DomainInsight
    One row per DOMAIN. Cached Progress-tab
    insights, generated from that domain's real
    data (logs, streak, PRs, milestones, weekly
    stats). Written by InsightsRefreshScheduler
    (3 AM) + manual refresh; read by GET /api/insights?domainId.
  end note

  class SessionMetricValue {
    - id : UUID <<PK>>
    - sessionLogId : UUID <<FK>>
    - metricKey : String
    - numericValue : Double
    - unit : String
  }

  note right of SessionMetricValue
    One row per metric per session.
    Same table for every domain.
    GYM session rows:
      bench_press_kg  → 70.0
      bench_press_reps→ 8
      squat_kg        → 90.0
      squat_reps      → 5
      total_volume_kg → 3240
    RUNNING session rows:
      distance_km     → 5.2
      pace_per_km     → 6.32
      elevation_m     → 120
    Charts, PRs, weekly stats,
    milestones all read this table.
    Nothing else stores metric data.
  end note

  class PersonalRecord {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - domainId : UUID <<FK>>
    - sessionLogId : UUID <<FK>>
    - metricKey : String
    - value : Double
    - unit : String
    - achievedAt : LocalDate
    - previousValue : Double
    --
    + toDto() : PersonalRecordDto
  }

  note right of PersonalRecord
    One row per PR-trackable metric
    per domain. Upserted on each save.
    previousValue stored for delta
    display on celebration screen.
    Works identically for bench_press_kg,
    distance_km, pace_per_km — no
    exercise-specific fields.
  end note

  class Milestone {
    - id : UUID <<PK>>
    - domainId : UUID <<FK>>
    - label : String
    - metricKey : String
    - targetValue : Double
    - currentValue : Double
    - unit : String
    - status : MilestoneStatus <<enum>>
    - deadline : LocalDate
    - completedAt : LocalDate
    - aiGenerated : boolean
    - createdAt : LocalDateTime
    --
    + progressPercent() : Double
    + toDto() : MilestoneDto
  }

  class Task {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - domainId : UUID <<FK>>
    - title : String
    - description : String
    - status : TaskStatus <<enum>>
    - dueDate : LocalDate
    - completedAt : LocalDateTime
    - progress : Integer
    - aiGenerated : boolean
    - linkedResourceUrl : String
    - linkedResourceTitle : String
    - createdAt : LocalDateTime
    --
    + toDto() : TaskDto
  }

  class AiNudge {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - domainId : UUID <<FK>>
    - message : String
    - nudgeType : NudgeType <<enum>>
    - isRead : boolean
    - generatedAt : LocalDateTime
    - readAt : LocalDateTime
    --
    + toDto() : AiNudgeDto
  }

  note right of AiNudge
    Generated nightly by cron.
    One per domain per user per day max.
    Shown as a card on dashboard.
    MISSING_LOG: "Haven't logged gym
      in 3 days"
    STREAK_AT_RISK: "Log today or your
      12-day streak breaks tomorrow"
    PR_OPPORTUNITY: "You're 2.5kg away
      from a new bench PR"
    MILESTONE_CLOSE: "2km from your 5k
      distance milestone"
  end note

  class AiConversation {
    - id : UUID <<PK>>
    - userId : UUID <<FK>>
    - preview : String
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class AiMessage {
    - id : UUID <<PK>>
    - conversationId : UUID <<FK>>
    - role : MessageRole <<enum>>
    - content : String
    - status : MessageStatus <<enum>>
    - errorMessage : String
    - createdAt : LocalDateTime
  }
  note right of AiMessage
    status (SUCCESS/DEGRADED/FAILED) +
    errorMessage set on the ASSISTANT row
    by AiChatService. On a Gemini outage a
    FAILED assistant row is still written
    (with fallback text) so downtime is
    visible; not counted against daily limit.
    Health lives with the message (correct
    grain) — separate from scheduler audit.
  end note

  

  
}

' ============================================================
' ENUMS
' ============================================================
package "enums" {
  enum DomainType {
    GYM
    RUNNING
    READING
    GUITAR
    CHESS
    LANGUAGE
    NUTRITION
    SLEEP
    SWIMMING
    MEDITATION
    CUSTOM
  }
  enum SkillLevel {
    BEGINNER
    INTERMEDIATE
    ADVANCED
  }
  enum DomainStatus {
    ACTIVE
    PAUSED
    NEEDS_LOG
    COMPLETED_MILESTONE
    ARCHIVED
  }
  enum FeelLabel {
    STRONG
    OKAY
    TIRED
    ROUGH
  }
  enum MilestoneStatus {
    UPCOMING
    IN_PROGRESS
    DONE
    MISSED
  }
  enum TaskStatus {
    TODO
    IN_PROGRESS
    DONE
    SKIPPED
  }
  enum NudgeType {
    MISSING_LOG
    STREAK_AT_RISK
    PR_OPPORTUNITY
    REST_RECOMMENDED
    PLAN_ADJUST
    MILESTONE_CLOSE
    WEEKLY_SUMMARY
  }
  enum MessageRole {
    USER
    ASSISTANT
    SYSTEM
  }
  enum ChatMode {
    ADJUST_PLAN
    DATA_QUERY
  }
}

