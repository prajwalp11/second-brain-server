  }
  class MetricValidator {
    + validateKeys(submitted: Set<String>, defined: List<DomainMetricDefinition>) : void
    + clampValues(submitted: Map<String,Double>, defined: List<DomainMetricDefinition>) : Map<String,Double>
    + clamp(value: Double, metric: DomainMetricDefinition) : Double
  }
  note right of MetricValidator
    clampValues enforces metric bounds on
    session logs. Bounds are inferred, never
    required from the user: declared min/max
    win; else unit '%'/percent -> 0..100;
    else floor 0, no ceiling. Stops percentage
    and score metrics exceeding 100%.
  end note
  class ContextWindowUtil {
    + truncateToLimit(text: String, maxTokens: Integer) : String
  }
