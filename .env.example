# Second Brain Server — environment variables (example)
# Copy to a real env (do NOT commit secrets) and fill in values.
# These map to placeholders in src/main/resources/application.properties.

# --- Security ---
# Long random string. Change in production. Local dev can use any 32+ char value.
JWT_SECRET=change-me-to-a-long-random-secret
# JWT lifetimes (optional, defaults shown): access 1h, refresh 60d (rotating).
JWT_ACCESS_TOKEN_EXPIRY_MS=3600000
JWT_REFRESH_TOKEN_EXPIRY_MS=5184000000

# --- Google SSO ---
# Accepted ID-token audiences = your Google OAuth client IDs, comma-separated.
# The app uses the native Google Sign-In SDK with a WEB client id as webClientId, so the
# id_token's audience is the WEB client — list it here. Include iOS/Android client ids too if
# any flow issues tokens with those audiences. Order does not matter.
GOOGLE_SSO_CLIENT_ID=your_web_client_id.apps.googleusercontent.com,your_ios_client_id.apps.googleusercontent.com,your_android_client_id.apps.googleusercontent.com

# --- Database (PostgreSQL) ---
# DATABASE_URL has a default pointing at local Postgres; override for prod.
DATABASE_URL=jdbc:postgresql://localhost:5432/secondbrain_db
DB_USERNAME=sbuser
DB_PASSWORD=your_db_password

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- AI usage / generation limits ---
# Per-user daily AI chat message limit (default 3).
AI_DAILY_LIMIT=3
# Skip daily task generation for a domain once it has this many open tasks (default 5).
MAX_TASKS_PER_DOMAIN=5

# --- YouTube Data API (task resource links + curriculum video vetting; optional) ---
# Powers VideoResolver (search -> enrich stats -> rank -> cache) behind every curriculum step.
# If unset, the resolver degrades gracefully to a YouTube search-results URL (LOW confidence) and
# no "Was this helpful?" prompt is shown for that step — the app still works.
YOUTUBE_API_KEY=your_youtube_api_key

# --- Resend (transactional email: password reset) ---
RESEND_API_KEY=your_resend_api_key
# Sender address. Start with Resend's test sender; switch to your verified domain later.
MAIL_FROM=onboarding@resend.dev

# --- OTP policy (shared by password reset + email verification; all optional, defaults shown) ---
AUTH_OTP_EXPIRY_MS=1800000       # code lifetime (30 min)
AUTH_OTP_MAX_REQUESTS=5          # max code emails per rolling window
AUTH_OTP_WINDOW_HOURS=12         # rolling window for the request cap
AUTH_OTP_MAX_ATTEMPTS=10         # wrong-code guesses before a code is invalidated

# --- Logging (file output + rolling cleanup; all optional, defaults shown) ---
LOG_DIR=logs                           # folder for app.log (created automatically)
LOG_MAX_FILE_SIZE=10MB                 # roll a day's file past this size
LOG_MAX_HISTORY=14                     # days of history to keep
LOG_TOTAL_SIZE_CAP=200MB               # hard cap on total log size; oldest deleted beyond this

# --- Timezone ---
# Fallback IANA timezone for users who haven't reported one from their device (the app sends the
# device zone on login). All per-user "today / this week / what hour" logic uses the user's own
# timezone when known, else this default.
APP_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Push notifications (Expo; all optional, defaults shown) ---
# Expo Push API is free and needs no server key (iOS APNs key + Android FCM creds live in EAS).
# Per-type cooldown (hours): a type is sent at most once per window; types are independent.
PUSH_COOLDOWN_TASK_DUE_HOURS=12
PUSH_COOLDOWN_STREAK_AT_RISK_HOURS=12
PUSH_COOLDOWN_WEEKLY_INSIGHT_HOURS=144   # ~weekly; the weekly flow governs real cadence
PUSH_SENDER_BATCH=100                    # Expo accepts <=100 messages per request
PUSH_MAX_ATTEMPTS=5                      # retries before an outbox row is marked FAILED
PUSH_WINDOW_MORNING=08:00-10:00          # server-local TASK_DUE send window
PUSH_WINDOW_EVENING=18:00-21:00          # server-local STREAK_AT_RISK send window
