# Second Brain Server — environment variables (example)
# Copy to a real env (do NOT commit secrets) and fill in values.
# These map to placeholders in src/main/resources/application.properties.

# --- Security ---
# Long random string. Change in production. Local dev can use any 32+ char value.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Database (PostgreSQL) ---
# DATABASE_URL has a default pointing at local Postgres; override for prod.
DATABASE_URL=jdbc:postgresql://localhost:5432/secondbrain_db
DB_USERNAME=sbuser
DB_PASSWORD=your_db_password

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- AI usage / generation limits ---
# Per-user daily AI chat message limit (default 3).
AI_DAILY_LIMIT=3
# Skip daily task generation for a domain once it has this many open tasks (default 5).
MAX_TASKS_PER_DOMAIN=5

# --- YouTube Data API (task resource links; optional) ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- Resend (transactional email: password reset) ---
RESEND_API_KEY=your_resend_api_key
# Sender address. Start with Resend's test sender; switch to your verified domain later.
MAIL_FROM=onboarding@resend.dev

# --- OTP policy (shared by password reset + email verification; all optional, defaults shown) ---
AUTH_OTP_EXPIRY_MS=1800000       # code lifetime (30 min)
AUTH_OTP_MAX_REQUESTS=5          # max code emails per rolling window
AUTH_OTP_WINDOW_HOURS=12         # rolling window for the request cap
AUTH_OTP_MAX_ATTEMPTS=10         # wrong-code guesses before a code is invalidated

# --- Logging (file output + rolling cleanup; all optional, defaults shown) ---
LOG_DIR=logs                           # folder for app.log (created automatically)
LOG_MAX_FILE_SIZE=10MB                 # roll a day's file past this size
LOG_MAX_HISTORY=14                     # days of history to keep
LOG_TOTAL_SIZE_CAP=200MB               # hard cap on total log size; oldest deleted beyond this
